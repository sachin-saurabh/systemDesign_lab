# Optional overrides. The defaults in docker-compose.yml are fine for a local lab.
# Never reuse these values anywhere real.
LAB_DB_PASSWORD=change_me_db
LAB_REPL_PASSWORD=change_me_repl
LAB_MQ_PASSWORD=change_me_mq
# key:bucketCapacity:refillPerSecond
LAB_API_KEYS=free-key:5:1,pro-key:50:10
# Load balancer algorithm: lb.round_robin.conf | lb.least_conn.conf | lb.ip_hash.conf
LB_CONF=lb.round_robin.conf
# Shard routing: ring (consistent hashing) | mod (hash % N)
SHARD_STRATEGY=ring
# Simulated work per queue message, in milliseconds
PROCESS_MS=300
