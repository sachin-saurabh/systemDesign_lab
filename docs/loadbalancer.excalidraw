      "updated": 1791125791437,
      "link": null,
      "locked": false,
      "text": "same client request goes to same\nserver,ie\nclient c1 request will always go to\nserver s1, c2---> s2 and so on",
      "fontSize": 12.743692359079361,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "same client request goes to same server,ie\nclient c1 request will always go to server s1, c2---> s2 and so on",
      "autoResize": false,
      "lineHeight": 1.25
    },
