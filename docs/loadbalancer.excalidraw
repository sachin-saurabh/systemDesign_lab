    {
      "id": "SwFHium2xDc4VBRhGyDMz",
      "type": "text",
      "x": 847.4203121422538,
      "y": 432.4108929469695,
      "width": 376.59027099609375,
      "height": 308.68534499046973,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 890031384,
      "version": 442,
      "versionNonce": 1620362088,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791129751109,
      "link": null,
      "locked": false,
      "text": "# Load balancer: round robin (nginx default). Requests rotate \napi1 -> api2 -> api3.\n\nupstream api_pool {\n    server api1:8000 max_fails=2 fail_timeout=10s;\n    server api2:8000 max_fails=2 fail_timeout=10s;\n    server api3:8000 max_fails=2 fail_timeout=10s;\n}\n\nserver {\n    listen 80;\n\n    location / {\n        proxy_pass http://api_pool;\n        # If a backend errors or times out, quietly retry on another one.\n        proxy_next_upstream error timeout http_502 http_503;\n        proxy_connect_timeout 1s;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        add_header X-LB \"<<NGINX-LB-Algo>>\" always;\n    }\n}\n",
      "fontSize": 10.736881564885904,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "s7C7sMZNr05WFqTxD433R",
      "originalText": "# Load balancer: round robin (nginx default). Requests rotate \napi1 -> api2 -> api3.\n\nupstream api_pool {\n    server api1:8000 max_fails=2 fail_timeout=10s;\n    server api2:8000 max_fails=2 fail_timeout=10s;\n    server api3:8000 max_fails=2 fail_timeout=10s;\n}\n\nserver {\n    listen 80;\n\n    location / {\n        proxy_pass http://api_pool;\n        # If a backend errors or times out, quietly retry on another one.\n        proxy_next_upstream error timeout http_502 http_503;\n        proxy_connect_timeout 1s;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        add_header X-LB \"<<NGINX-LB-Algo>>\" always;\n    }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
